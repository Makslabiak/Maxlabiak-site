# ── Порт сервера (он же отдаёт статику сайта) ──
PORT=3000

# ── Google PageSpeed Insights ──
# Ключ бесплатный: https://console.cloud.google.com → включить "PageSpeed Insights API" → Credentials → API key.
# Без ключа лимит ~1 запрос в секунду и частые 429; аудит не падает, но блок скорости может быть недоступен.
PAGESPEED_API_KEY=

# ── Telegram для заявок ──
# Токен у @BotFather. CHAT_ID — свой id (узнать у @userinfobot) или id канала/группы.
# Если пусто — заявки пишутся в server/temp/leads.json (ТОЛЬКО для разработки).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Скриншоты ──
# Через сколько часов временные скриншоты удаляются
AUDIT_SCREENSHOT_TTL_HOURS=24

# ── Режим разработки ──
# true — backend отдаёт готовый тестовый отчёт без PageSpeed и Playwright.
# НИКОГДА не включать в production.
AUDIT_MOCK_MODE=false
# Какой сценарий отдавать: good | average | bad | random
AUDIT_MOCK_SCENARIO=average

# ── Лимиты ──
AUDIT_RATE_LIMIT_WINDOW_MIN=15
AUDIT_RATE_LIMIT_MAX=5
AUDIT_CACHE_TTL_MIN=45
